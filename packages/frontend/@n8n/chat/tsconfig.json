{
	"extends": "@n8n/typescript-config/tsconfig.common.json",
	"compilerOptions": {
		"noEmit": true,
		"rootDirs": [".", "../design-system/src"],
		"target": "esnext",
		"module": "esnext",
		"moduleResolution": "bundler",
		"allowJs": true,
		"importHelpers": true,
		"incremental": false,
		"allowSyntheticDefaultImports": true,
		"resolveJsonModule": true,
		"types": ["vitest/globals", "vitest/browser", "@testing-library/vue"],
		"paths": {
			"@eit/json-render-element-plus": [
				"../../../../../eit-json-render/packages/element-plus/dist/index.d.ts"
			],
			"@eit/json-render-protocol": [
				"../../../../../eit-json-render/packages/protocol/dist/index.d.ts"
			],
			"@eit/json-render-vue": ["../../../../../eit-json-render/packages/vue/dist/index.d.ts"],
			"@n8n/chat/*": ["./src/*"],
			"@n8n/design-system*": ["../design-system/src*"]
		},
		"lib": ["esnext", "dom", "dom.iterable", "scripthost"],
		// TODO: remove all options below this line
		"useUnknownInCatchVariables": false
	},
	"include": ["**/*.ts", "**/*.vue"]
}
